# {{project_name}}: API docs and the doc comment check. `make docs` builds docs/api, and
# `make docs-check` runs scripts/docs-check.sh, which decides what counts as a failure.
PROJECT_NAME           = "{{project_name}}"
INPUT                  = {{doxygen_input}}
FILE_PATTERNS          = {{doxygen_file_patterns}}
EXCLUDE_PATTERNS       = {{doxygen_exclude_patterns}}
RECURSIVE              = YES
OUTPUT_DIRECTORY       = docs
HTML_OUTPUT            = api
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES

# Private, static, package-private and anonymous-namespace code needs doc comments too.
# EXTRACT_ALL must stay NO: at YES, Doxygen stops reporting undocumented code.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
