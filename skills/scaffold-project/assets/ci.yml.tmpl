name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_call:   # release.yml runs these checks first, when it's present

permissions:
  contents: read

env:
  CONTAINER: docker   # or podman: the Makefile accepts either

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
{{check_jobs}}

  security:
    name: Security scans
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{ref:actions/checkout}}
        with:
          fetch-depth: 0
          persist-credentials: false
      - run: make ci-security
{{image_scan_steps}}
